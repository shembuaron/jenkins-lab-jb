// NOTE: Doesn't actually work due to app-generator being nuked + Docker CLI being a nuisance. Should work in principle though
pipeline {
    agent {
      node { label 'k8s-agent' }
    }

    environment {
        IMAGE_NAME = 'app-generator:latest'
        GIT_URL = 'https://github.com/app-generator/app-generator.git'
        GIT_BRANCH  = 'main'
    }

    stages {
        stage('Checkout') {
            steps {
                container('git') {
                    git branch: "${GIT_BRANCH}", url: "${GIT_URL}"                    
                }
            }
        }

        stage('Lint & Static Analysis') {
            steps {
                container ('python3') {
                    sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install flake8
                    [ -f requirements.txt ] && pip install -r requirements.txt || echo "No requirements.txt found"
                    flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics
                    '''
                }
            }
        }

        stage('Execute Tests') {
            steps {
                container ('python3') {
                    sh '''
                    . venv/bin/activate
                    pip install pytest
                    pytest  . . . 
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                container ('docker') {
                    sh "docker build . -t ${IMAGE_NAME}"                    
                }
            }
        }
    }

    post {
        always {
            container ('docker') {
                echo 'Cleaning up workspace and local Docker images...'
                sh "docker rmi ${IMAGE_NAME}"
            }
        }
        success {
            echo 'Pipeline Succeeded!'
        }
        failure {
            echo 'Pipeline Failed!'
        }
    }
}
